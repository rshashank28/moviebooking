# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/showpulse

# Redis Configuration (Optional in dev; falls back to in-memory store)
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=super_secret_jwt_access_token_key_showpulse_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_showpulse_2026
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Configuration (Mock / Test keys)
RAZORPAY_KEY_ID=rzp_test_showpulse_key
RAZORPAY_KEY_SECRET=rzp_test_showpulse_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_showpulse

# Cloudinary / Image Upload (Optional)
CLOUDINARY_CLOUD_NAME=showpulse_demo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Assistant API Key (Gemini / OpenAI optional fallback)
AI_API_KEY=
